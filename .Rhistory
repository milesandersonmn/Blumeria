#install.packages("abcrf")
library(abcrf)
#install.packages("pheatmap")
library(pheatmap)
#install.packages("reshape2")
library(reshape2)
library(ggplot2)
setwd("~/PhD/Blumeria/")
summary_table_kingman_bottleneck <- read.csv("summary_stats/kingman_bottleneck.csv", header = TRUE)
summary_table_beta_constant <- read.csv("summary_stats/beta_constant.csv", header = TRUE)
summary_table_beta_bottleneck <- read.csv("summary_stats/beta_bottleneck.csv", header = TRUE)
#names(summary_table2) <- names(summary_table)
summary_table <- rbind(summary_table_kingman_bottleneck, summary_table_beta_constant, summary_table_beta_bottleneck)
#summary_table <- subset(summary_table, select = -V61)
#tail(summary_table)
txt <- summary_table[ ,-c(2:12)]
modindex <- as.factor(txt$X0)
sumsta <- txt[,-1]
header <- c( "modindex",
"fSFS1", "fSFS2", "fSFS3",
"fSFS4", "fSFS5", "fSFS6", "fSFS7", "fSFS8",
"fSFS9", "fSFS10", "fSFS11", "fSFS12", "fSFS13",
"fSFS14", "fSFS15", "AFS_q0.1", "AFS_q0.3", "AFS_q0.5", "AFS_q0.7", "AFS_q0.9",
